{"manifest":{"schema":1,"apiVersion":2,"id":"kai.model-compare","name":"KAI Model Compare","version":"0.1.0","description":"Compare two installed local models on the same prompt, with response timings and saved comparisons on this device.","entry":"index.html","permissions":["models.read","inference.local","storage.read","storage.write"]},"files":{"app.js":"\"use strict\";\n(() => {\n  const $ = id => document.getElementById(id), call = (method, input) => window.kai.call(method, input), logic = window.CompareLogic;\n  const state = { models: [], history: [], current: null, busy: false, running: false, stop: false, storageReady: true, pendingDelete: null, unsaved: false };\n  function notice(message, error = false) { $(\"notice\").textContent = message || \"\"; $(\"notice\").hidden = !message; $(\"notice\").classList.toggle(\"error\", error); }\n  function controls() {\n    for (const id of [\"prompt\", \"model-a\", \"model-b\", \"tokens\", \"refresh\"]) $(id).disabled = state.busy;\n    $(\"compare\").disabled = state.busy || state.unsaved || !$(\"model-a\").value || !$(\"model-b\").value;\n    $(\"stop\").hidden = !state.running; $(\"stop\").disabled = state.stop;\n    $(\"save-again\").hidden = !state.unsaved || !state.storageReady; $(\"save-again\").disabled = state.busy;\n    for (const button of document.querySelectorAll(\".history button,[data-prompt]\")) button.disabled = state.busy || state.unsaved;\n  }\n  function renderResults() {\n    const item = state.current; $(\"results\").hidden = !item; if (!item) return;\n    for (let index = 0; index < 2; index++) {\n      const side = index === 0 ? \"a\" : \"b\", result = item.results[index]; $(\"name-\" + side).textContent = result.label || result.model; $(\"meta-\" + side).textContent = logic.summarize(result);\n      $(\"state-\" + side).textContent = { done: \"COMPLETE\", error: \"FAILED\", skipped: \"STOPPED\", running: \"THINKING\", queued: \"QUEUED\" }[result.status];\n      $(\"result-\" + side).classList.toggle(\"failed\", result.status === \"error\"); $(\"result-\" + side).classList.toggle(\"running\", result.status === \"running\");\n      $(\"text-\" + side).textContent = result.text || (result.status === \"running\" ? \"Your local model is working on the prompt…\" : result.status === \"queued\" ? \"This model will run after the first response finishes.\" : \"This model was not run.\");\n    }\n  }\n  function renderHistory() {\n    $(\"history\").replaceChildren(); $(\"history-count\").textContent = `${state.history.length} / ${logic.MAX_ENTRIES} saved`;\n    for (const item of state.history) {\n      const row = document.createElement(\"div\"); row.className = \"history-row\";\n      const open = document.createElement(\"button\"); open.className = \"history-open\"; const title = document.createElement(\"strong\"); title.textContent = item.prompt;\n      const meta = document.createElement(\"span\"); const date = new Date(item.createdAt); meta.textContent = `${item.results.map(r => r.label || r.model).join(\"  /  \")}${Number.isNaN(date.getTime()) ? \"\" : \" · \" + date.toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" })}`;\n      open.append(title, meta); open.addEventListener(\"click\", () => { if (state.busy || state.unsaved) return; state.current = item; $(\"prompt\").value = item.prompt; for (const [index, side] of [[0, \"a\"], [1, \"b\"]]) if (state.models.some(m => m.alias === item.results[index].model)) $(\"model-\" + side).value = item.results[index].model; if ([512, 1024, 2048, 4096].includes(item.maxTokens)) $(\"tokens\").value = item.maxTokens; $(\"save-status\").textContent = \"Saved on this device\"; notice(\"\"); renderResults(); $(\"results\").scrollIntoView({ behavior: \"smooth\", block: \"start\" }); });\n      const remove = document.createElement(\"button\"); remove.className = \"delete-row\"; remove.textContent = \"Delete\"; remove.setAttribute(\"aria-label\", \"Delete comparison: \" + item.prompt.slice(0, 60)); remove.addEventListener(\"click\", () => { if (state.busy || state.unsaved) return; state.pendingDelete = item.id; $(\"delete-dialog\").showModal(); });\n      row.append(open, remove); $(\"history\").append(row);\n    }\n    if (!state.history.length) { const empty = document.createElement(\"p\"); empty.className = \"empty-history\"; empty.textContent = \"Your completed comparisons will appear here, saved on this device.\"; $(\"history\").append(empty); } controls();\n  }\n  async function loadModels() {\n    const previous = [$(\"model-a\").value, $(\"model-b\").value]; state.models = logic.readyModels(await call(\"models.list\", {})); $(\"model-count\").textContent = state.models.length;\n    for (const [index, side] of [[0, \"a\"], [1, \"b\"]]) {\n      const select = $(\"model-\" + side); select.replaceChildren();\n      for (const model of state.models) { const option = document.createElement(\"option\"); option.value = model.alias; option.textContent = model.label; select.append(option); }\n      if (!state.models.length) { const option = document.createElement(\"option\"); option.value = \"\"; option.textContent = \"No installed local model\"; select.append(option); }\n      else select.value = state.models.some(m => m.alias === previous[index]) ? previous[index] : state.models[Math.min(index, state.models.length - 1)].alias;\n    }\n    if (!state.models.length) notice(\"Install a local model in Core → Models, then refresh. Model Compare uses installed models only.\");\n    else if (state.models.length === 1) notice(\"One model is available. You can compare two independent replies from it, or install a second model in Core.\"); controls();\n  }\n  async function saveCurrent() {\n    if (!state.storageReady) { $(\"save-status\").textContent = \"Not saved: existing history needs attention\"; return; }\n    const next = logic.addHistory(state.history, state.current);\n    if (!next.saved) { $(\"save-status\").textContent = \"Response too large to save; select and copy the text to keep it.\"; state.unsaved = false; return; }\n    try { await call(\"storage.set\", { key: \"history\", value: next.entries }); state.history = next.entries; state.unsaved = false; $(\"save-status\").textContent = next.removed ? `Saved · ${next.removed} oldest comparison(s) removed to fit storage` : \"Saved on this device\"; renderHistory(); }\n    catch (error) { state.unsaved = true; $(\"save-status\").textContent = \"Not saved yet\"; controls(); throw error; }\n  }\n  async function run(event) {\n    event.preventDefault(); if (state.busy || state.unsaved) return;\n    let request; try { request = logic.validateRequest($(\"prompt\").value, $(\"model-a\").value, $(\"model-b\").value, Number($(\"tokens\").value), state.models); } catch (error) { notice(error.message, true); return; }\n    state.busy = true; state.running = true; state.stop = false; notice(\"\"); $(\"save-status\").textContent = \"\";\n    state.current = { id: `cmp-${Date.now().toString(36)}-${crypto.randomUUID()}`, createdAt: new Date().toISOString(), prompt: request.prompt, maxTokens: request.maxTokens, results: [request.a, request.b].map(model => ({ model, label: state.models.find(m => m.alias === model).label, status: \"queued\", text: \"\", elapsedMs: 0 })) };\n    controls(); renderResults(); $(\"results\").scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n    try {\n      for (let i = 0; i < 2; i++) {\n        const result = state.current.results[i];\n        if (state.stop) { result.status = \"skipped\"; renderResults(); continue; }\n        result.status = \"running\"; $(\"run-status\").textContent = `Running model ${i + 1} of 2…`; renderResults(); const started = performance.now();\n        try { const response = await call(\"inference.local\", { model: result.model, prompt: request.prompt, maxTokens: request.maxTokens }); if (typeof response?.text !== \"string\" || !response.text.trim()) throw Error(\"The model returned an empty response.\"); result.text = response.text; result.status = \"done\"; }\n        catch (error) { result.text = error.message || String(error); result.status = \"error\"; }\n        result.elapsedMs = performance.now() - started; renderResults();\n      }\n      $(\"run-status\").textContent = state.stop ? \"Stopped\" : \"Comparison finished\"; await saveCurrent();\n    } catch (error) { notice(error.message || String(error), true); }\n    finally { state.busy = false; state.running = false; controls(); }\n  }\n  async function guarded(action) { if (state.busy) return; state.busy = true; controls(); try { await action(); } catch (error) { notice(error.message || String(error), true); } finally { state.busy = false; controls(); } }\n  $(\"comparison-form\").addEventListener(\"submit\", run); $(\"refresh\").addEventListener(\"click\", () => guarded(loadModels));\n  $(\"stop\").addEventListener(\"click\", () => { state.stop = true; $(\"run-status\").textContent = \"Will stop when the current model finishes\"; controls(); });\n  $(\"save-again\").addEventListener(\"click\", () => guarded(saveCurrent));\n  $(\"cancel-delete\").addEventListener(\"click\", () => { state.pendingDelete = null; $(\"delete-dialog\").close(); });\n  $(\"confirm-delete\").addEventListener(\"click\", () => guarded(async () => { const next = state.history.filter(item => item.id !== state.pendingDelete); await call(\"storage.set\", { key: \"history\", value: next }); state.history = next; if (state.current?.id === state.pendingDelete) { state.current = null; renderResults(); } state.pendingDelete = null; $(\"delete-dialog\").close(); renderHistory(); }));\n  for (const button of document.querySelectorAll(\"[data-prompt]\")) button.addEventListener(\"click\", () => { $(\"prompt\").value = button.dataset.prompt; $(\"prompt\").focus(); });\n  for (const id of [\"model-a\", \"model-b\", \"tokens\"]) $(id).addEventListener(\"change\", () => guarded(() => call(\"storage.set\", { key: \"preferences\", value: { a: $(\"model-a\").value, b: $(\"model-b\").value, maxTokens: Number($(\"tokens\").value) } })));\n  void guarded(async () => {\n    if (!window.kai?.call || window.kai.apiVersion < 2) throw Error(\"Open this plugin in KAI Core 0.2.0 or later.\");\n    await loadModels();\n    try { state.history = logic.history(await call(\"storage.get\", { key: \"history\" })); renderHistory(); }\n    catch (error) { state.storageReady = false; notice(error.message || String(error), true); }\n    const prefs = await call(\"storage.get\", { key: \"preferences\" });\n    if (prefs) { for (const side of [\"a\", \"b\"]) if (state.models.some(m => m.alias === prefs[side])) $(\"model-\" + side).value = prefs[side]; if ([512, 1024, 2048, 4096].includes(prefs.maxTokens)) $(\"tokens\").value = String(prefs.maxTokens); }\n  });\n})();\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>KAI Model Compare</title><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<div class=\"app\"><header><div class=\"identity\"><span class=\"brand-icon\">k</span><span>KAI <strong>Model Compare</strong></span></div><div class=\"local-badge\"><i></i> ON-DEVICE INFERENCE</div></header>\n<main><section class=\"heading\"><div><div class=\"eyebrow\">TWO MODELS. ONE QUESTION.</div><h1>Find the right model<br>for the way you work.</h1><p>Give your local models the same prompt.<br>Compare their responses, clarity, and time to answer.</p></div><div class=\"count\"><strong id=\"model-count\">—</strong><span>local models ready</span><button id=\"refresh\">↻ Refresh models</button></div></section>\n<div id=\"notice\" class=\"notice\" role=\"status\" hidden></div>\n<form id=\"comparison-form\"><section class=\"setup\"><div class=\"setup-heading\"><h2>Your prompt</h2><span>Identical input, independent responses</span></div><label class=\"sr-only\" for=\"prompt\">Prompt for both models</label><textarea id=\"prompt\" maxlength=\"16000\" rows=\"3\" placeholder=\"What would you like both models to work on?\" required></textarea><div class=\"examples\"><span>Try a starting point</span><button type=\"button\" data-prompt=\"Explain how a hash table works to someone who has written their first program. Include a small example.\">Explain a concept</button><button type=\"button\" data-prompt=\"Write a concise, friendly email asking a colleague to review a draft by Friday. Include a clear subject line.\">Write a draft</button><button type=\"button\" data-prompt=\"I have three hours to prepare a presentation about a new product idea. Give me a practical plan and explain what to prioritize.\">Make a plan</button></div>\n<div class=\"model-pickers\"><label class=\"picker\"><span class=\"letter\">A</span><span class=\"picker-content\"><span>FIRST MODEL</span><select id=\"model-a\" aria-label=\"First model\"><option value=\"\">Loading models…</option></select></span></label><div class=\"versus\">vs</div><label class=\"picker\"><span class=\"letter b\">B</span><span class=\"picker-content\"><span>SECOND MODEL</span><select id=\"model-b\" aria-label=\"Second model\"><option value=\"\">Loading models…</option></select></span></label></div>\n<div class=\"run-bar\"><label for=\"tokens\">Reply limit <select id=\"tokens\"><option value=\"512\">512 tokens</option><option value=\"1024\" selected>1,024 tokens</option><option value=\"2048\">2,048 tokens</option><option value=\"4096\">4,096 tokens</option></select> <span>per model</span></label><span id=\"run-status\" role=\"status\"></span><button type=\"button\" id=\"stop\" hidden>Stop after current</button><button class=\"primary\" id=\"compare\" type=\"submit\" disabled>Compare models <span>↗</span></button></div></section></form>\n<section id=\"results\" class=\"results\" aria-label=\"Comparison results\" hidden><div class=\"results-heading\"><div><div class=\"eyebrow\">THE RESPONSES</div><h2 id=\"result-title\">Two perspectives, side by side.</h2></div><button id=\"save-again\" hidden>Retry saving</button><span id=\"save-status\"></span></div><div class=\"result-grid\"><article id=\"result-a\" class=\"result-card\"><div class=\"result-header\"><span class=\"letter\">A</span><div><h3 id=\"name-a\">First model</h3><span id=\"meta-a\">Waiting</span></div><span class=\"state\" id=\"state-a\">QUEUED</span></div><div id=\"text-a\" class=\"result-text\"></div></article><article id=\"result-b\" class=\"result-card\"><div class=\"result-header\"><span class=\"letter b\">B</span><div><h3 id=\"name-b\">Second model</h3><span id=\"meta-b\">Waiting</span></div><span class=\"state\" id=\"state-b\">QUEUED</span></div><div id=\"text-b\" class=\"result-text\"></div></article></div><p class=\"result-note\">Timing includes local model loading. Models run one after another to share device resources; this is a practical comparison, not a controlled benchmark.</p></section>\n<section class=\"saved\"><div class=\"saved-heading\"><div><div class=\"eyebrow\">YOUR EXPLORATIONS</div><h2>Saved comparisons</h2></div><span id=\"history-count\">0 saved</span></div><div id=\"history\" class=\"history\"><p class=\"empty-history\">Your completed comparisons will appear here, saved on this device.</p></div></section>\n<footer><span><i></i> Prompts and responses stay in your local plugin storage.</span><span>AI can make mistakes. Review results before relying on them.</span></footer></main></div><dialog id=\"delete-dialog\"><h2>Delete saved comparison?</h2><p>This removes the saved prompt and both responses from this plugin.</p><div><button id=\"cancel-delete\">Keep comparison</button><button id=\"confirm-delete\" class=\"danger\">Delete comparison</button></div></dialog><script src=\"logic.js\"></script><script src=\"app.js\"></script></body></html>\n","logic.js":"(function (root, factory) { const api = factory(); if (typeof module === \"object\" && module.exports) module.exports = api; else root.CompareLogic = api; })(typeof globalThis !== \"undefined\" ? globalThis : this, function () {\n  \"use strict\";\n  const MAX_HISTORY_BYTES = 650000, MAX_ENTRIES = 12;\n  function readyModels(value) { return Array.isArray(value) ? value.filter(m => m && m.status === \"ready\" && typeof m.alias === \"string\" && m.alias).map(m => ({ alias: m.alias, label: typeof m.label === \"string\" ? m.label : m.alias })) : []; }\n  function validateRequest(prompt, a, b, tokens, models) { if (typeof prompt !== \"string\" || !prompt.trim() || prompt.length > 16000) throw Error(\"Enter a prompt from 1 to 16,000 characters.\"); if (![512, 1024, 2048, 4096].includes(tokens)) throw Error(\"Choose a valid reply limit.\"); if (![a, b].every(alias => models.some(m => m.alias === alias))) throw Error(\"Choose two available local models.\"); return { prompt: prompt.trim(), a, b, maxTokens: tokens }; }\n  function history(value) { if (value == null) return []; if (!Array.isArray(value) || value.length > MAX_ENTRIES || value.some(item => !item || typeof item.id !== \"string\" || typeof item.prompt !== \"string\" || !Array.isArray(item.results) || item.results.length !== 2 || item.results.some(r => !r || typeof r.model !== \"string\" || ![\"done\", \"error\", \"skipped\"].includes(r.status) || typeof r.text !== \"string\"))) throw Error(\"Saved comparisons could not be read. Their stored data was not replaced.\"); return value; }\n  function addHistory(current, item) {\n    const bytes = value => new TextEncoder().encode(JSON.stringify(value)).length;\n    if (bytes([item]) > MAX_HISTORY_BYTES) return { entries: current, saved: false, removed: 0 };\n    const entries = [item, ...current.filter(old => old.id !== item.id)]; let removed = 0;\n    while (entries.length > MAX_ENTRIES || bytes(entries) > MAX_HISTORY_BYTES) { entries.pop(); removed++; }\n    return { entries, saved: true, removed };\n  }\n  function summarize(result) { if (result.status === \"done\") return `${(Math.max(0, result.elapsedMs) / 1000).toFixed(1)}s · ${result.text.trim().split(/\\s+/u).filter(Boolean).length} words`; return result.status === \"error\" ? \"Request failed\" : result.status === \"skipped\" ? \"Stopped before this model ran\" : result.status === \"running\" ? \"Generating on your device…\" : \"Waiting for the first model\"; }\n  return { readyModels, validateRequest, history, addHistory, summarize, MAX_ENTRIES };\n});\n","style.css":":root{color-scheme:dark;--bg:#101219;--panel:#191c26;--line:#303442;--text:#edf0f9;--muted:#99a1b5;--accent:#b7a7ff;--mint:#89d9bd;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{padding:9px 12px;border:1px solid var(--line);background:#242836;color:var(--text);border-radius:8px;cursor:pointer}button:hover:enabled{background:#34384a}button:disabled{opacity:.45;cursor:not-allowed}button:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}textarea,select{background:#11151e;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:10px;min-width:0}.primary{background:var(--accent);border-color:var(--accent);color:#1b152a;font-weight:650}.primary:hover:enabled{background:#c7bcff}.primary span{margin-left:20px}.app{max-width:1400px;margin:auto}header{display:flex;align-items:center;justify-content:space-between;padding:23px 38px;border-bottom:1px solid #252a36;gap:20px}.identity{display:flex;gap:11px;align-items:center;font-size:17px;letter-spacing:-.2px}.identity strong{font-weight:500}.brand-icon{width:34px;height:34px;display:grid;place-items:center;font-size:28px;font-weight:700;background:#322b49;color:var(--accent);border:1px solid #52456d;border-radius:10px}.local-badge{font-size:8px;color:var(--mint);letter-spacing:1.2px;padding:8px 10px;border:1px solid #294b43;background:#182822;border-radius:6px}i{display:inline-block;width:5px;height:5px;background:var(--mint);border-radius:50%;margin-right:7px}main{padding:31px 38px 20px}.heading{display:flex;align-items:center;justify-content:space-between;padding:0 0 28px}.eyebrow{font-size:9px;letter-spacing:1.8px;color:var(--accent);font-weight:550}h1{font-size:31px;letter-spacing:-1.1px;font-weight:520;line-height:1.15;margin:13px 0 11px}.heading p{font-size:12px;color:var(--muted);line-height:1.75;margin:0}.count{display:flex;flex-direction:column;text-align:right}.count strong{font-size:44px;letter-spacing:-2px;font-weight:400;color:var(--mint)}.count span{font-size:11px;color:var(--muted);margin:2px 0 14px}.count button{font-size:10px;background:transparent;padding:7px 10px}.setup{border:1px solid #343746;background:linear-gradient(130deg,#1d202c,#181b25);border-radius:13px;padding:21px 22px 0}.setup-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.setup-heading h2{font-size:14px;font-weight:550;margin:0}.setup-heading>span{font-size:10px;color:var(--muted)}textarea{width:100%;min-height:95px;max-height:300px;resize:vertical;line-height:1.6;padding:13px 14px;font-size:13px}.examples{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:10px 0 22px}.examples>span{font-size:9px;color:var(--muted);margin-right:5px}.examples button{font-size:9px;padding:5px 8px;background:#242735;border-color:#333746}.model-pickers{display:flex;gap:13px;align-items:center;margin-bottom:22px}.picker{display:flex;flex:1;gap:13px;align-items:center;min-width:0;border:1px solid #36394c;border-radius:10px;padding:12px;background:#141821}.letter{display:grid;place-items:center;flex-shrink:0;width:31px;height:31px;border-radius:8px;color:var(--accent);background:#332c49;border:1px solid #4c4165;font-size:12px;font-weight:650}.letter.b{color:var(--mint);background:#20372f;border-color:#365749}.picker-content{min-width:0;flex:1}.picker-content>span{font-size:8px;letter-spacing:1.3px;color:var(--muted);display:block;margin-bottom:6px}.picker-content select{border:0;background:transparent;padding:0;width:100%;font-size:12px}.versus{font-size:11px;color:var(--muted)}.run-bar{border-top:1px solid #303443;padding:15px 0;display:flex;align-items:center;gap:10px}.run-bar label{font-size:10px;color:var(--muted);white-space:nowrap}.run-bar select{font-size:10px;border:0;background:transparent;padding:5px}.run-bar label>span{color:#68748c}.run-bar>.primary{margin-left:auto;font-size:11px;padding:11px 15px}#run-status{font-size:10px;color:var(--mint)}#stop{font-size:10px;padding:7px}.results{margin-top:32px}.results-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}h2{font-size:20px;font-weight:500;letter-spacing:-.4px;margin:8px 0}.results-heading>span{font-size:10px;color:var(--muted);max-width:300px;text-align:right}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.result-card{border:1px solid #303746;border-radius:12px;background:#171b25;min-width:0;overflow:hidden}.result-card.running{border-color:#76669c}.result-card.failed{border-color:#70515b}.result-header{display:flex;align-items:center;gap:10px;padding:15px 16px;border-bottom:1px solid #2b3040}.result-header>div{min-width:0}.result-header h3{font-size:12px;font-weight:550;overflow-wrap:anywhere;margin:0 0 5px}.result-header>div>span{font-size:9px;color:var(--muted)}.state{margin-left:auto;font-size:7px;color:var(--mint);letter-spacing:.8px}.failed .state{color:#edacbb}.result-text{padding:20px 17px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.75;font-size:12px;min-height:140px;max-height:700px;overflow:auto}.result-note{font-size:10px;color:var(--muted);line-height:1.7;margin:11px 2px}.saved{margin-top:35px}.saved-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.saved-heading>span{font-size:10px;color:var(--muted)}.saved .eyebrow{color:var(--muted)}.saved h2{font-size:18px}.history{border-top:1px solid #2b3040}.empty-history{border:1px dashed #34394a