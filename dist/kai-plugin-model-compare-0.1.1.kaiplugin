{"manifest":{"schema":1,"apiVersion":2,"id":"kai.model-compare","name":"KAI Model Compare","version":"0.1.1","description":"Compare two installed local models on the same prompt, with response timings and saved comparisons on this device.","entry":"index.html","permissions":["models.read","inference.local","storage.read","storage.write"]},"files":{"app.js":"\"use strict\";\n(() => {\n  const $ = id => document.getElementById(id), call = (method, input) => window.kai.call(method, input), logic = window.CompareLogic;\n  const state = { models: [], history: [], current: null, busy: false, running: false, stop: false, storageReady: true, pendingDelete: null, unsaved: false };\n  const banner = window.KaiPluginNotice.attach($(\"notice\"), { focusTarget: () => $(\"prompt\") });\n  function notice(message, error = false) { banner.show(message || \"\", { error, force: true }); }\n  function controls() {\n    for (const id of [\"prompt\", \"model-a\", \"model-b\", \"tokens\", \"refresh\"]) $(id).disabled = state.busy;\n    $(\"compare\").disabled = state.busy || state.unsaved || !$(\"model-a\").value || !$(\"model-b\").value;\n    $(\"stop\").hidden = !state.running; $(\"stop\").disabled = state.stop;\n    $(\"reveal\").disabled = state.busy;\n    for (const button of document.querySelectorAll(\"[data-pick]\")) button.disabled = state.busy || state.unsaved;\n    $(\"save-again\").hidden = !state.unsaved || !state.storageReady; $(\"save-again\").disabled = state.busy;\n    for (const button of document.querySelectorAll(\".history button,[data-prompt]\")) button.disabled = state.busy || state.unsaved;\n  }\n  function renderResults() {\n    const item = state.current; $(\"results\").hidden = !item; if (!item) return;\n    for (let index = 0; index < 2; index++) {\n      const side = index === 0 ? \"a\" : \"b\", result = item.results[index]; $(\"name-\" + side).textContent = item.revealed === false ? `Answer ${index + 1}` : `Answer ${index + 1} — ${result.label || result.model}`; $(\"meta-\" + side).textContent = logic.summarize(result);\n      $(\"state-\" + side).textContent = { done: \"COMPLETE\", error: \"FAILED\", skipped: \"STOPPED\", running: \"THINKING\", queued: \"QUEUED\" }[result.status];\n      $(\"result-\" + side).classList.toggle(\"failed\", result.status === \"error\"); $(\"result-\" + side).classList.toggle(\"running\", result.status === \"running\");\n      $(\"text-\" + side).textContent = result.text || (result.status === \"running\" ? \"Your local model is working on the prompt…\" : result.status === \"queued\" ? \"This model will run after the first response finishes.\" : \"This model was not run.\");\n    }\n    const settled = item.results.every(result => [\"done\", \"error\", \"skipped\"].includes(result.status));\n    $(\"verdict\").hidden = !settled;\n    $(\"reveal\").hidden = item.revealed !== false;\n    $(\"vote\").hidden = item.revealed === false || !item.results.every(result => result.status === \"done\") || [\"0\", \"1\", \"tie\"].includes(item.pick);\n    $(\"verdict-note\").textContent = item.pick === \"tie\" ? \"Your pick: Tie\" : [\"0\", \"1\"].includes(item.pick) ? `Your pick: Answer ${Number(item.pick) + 1}` : \"\";\n  }\n  function renderHistory() {\n    $(\"history\").replaceChildren(); $(\"history-count\").textContent = `${state.history.length} / ${logic.MAX_ENTRIES} saved`;\n    for (const item of state.history) {\n      const row = document.createElement(\"div\"); row.className = \"history-row\";\n      const open = document.createElement(\"button\"); open.className = \"history-open\"; const title = document.createElement(\"strong\"); title.textContent = item.prompt;\n      const meta = document.createElement(\"span\"); const date = new Date(item.createdAt); meta.textContent = `${item.revealed === false ? \"Models hidden · Reveal after reviewing\" : item.results.map(r => r.label || r.model).join(\"  /  \")}${Number.isNaN(date.getTime()) ? \"\" : \" · \" + date.toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" })}`;\n      open.append(title, meta); open.addEventListener(\"click\", () => { if (state.busy || state.unsaved) return; state.current = item; $(\"prompt\").value = item.prompt; for (const [index, side] of [[0, \"a\"], [1, \"b\"]]) { const model = Array.isArray(item.selectedModels) ? item.selectedModels[index] : item.revealed === false ? null : item.results[index].model; if (state.models.some(m => m.alias === model)) $(\"model-\" + side).value = model; } if ([512, 1024, 2048, 4096].includes(item.maxTokens)) $(\"tokens\").value = item.maxTokens; $(\"save-status\").textContent = \"Saved on this device\"; notice(\"\"); renderResults(); $(\"results\").scrollIntoView({ behavior: \"smooth\", block: \"start\" }); });\n      const remove = document.createElement(\"button\"); remove.className = \"delete-row\"; remove.textContent = \"Delete\"; remove.setAttribute(\"aria-label\", \"Delete comparison: \" + item.prompt.slice(0, 60)); remove.addEventListener(\"click\", () => { if (state.busy || state.unsaved) return; state.pendingDelete = item.id; $(\"delete-dialog\").showModal(); });\n      row.append(open, remove); $(\"history\").append(row);\n    }\n    if (!state.history.length) { const empty = document.createElement(\"p\"); empty.className = \"empty-history\"; empty.textContent = \"Your completed comparisons will appear here, saved on this device.\"; $(\"history\").append(empty); } controls();\n  }\n  async function loadModels() {\n    const previous = [$(\"model-a\").value, $(\"model-b\").value]; state.models = logic.readyModels(await call(\"models.list\", {})); $(\"model-count\").textContent = state.models.length;\n    for (const [index, side] of [[0, \"a\"], [1, \"b\"]]) {\n      const select = $(\"model-\" + side); select.replaceChildren();\n      for (const model of state.models) { const option = document.createElement(\"option\"); option.value = model.alias; option.textContent = model.label; select.append(option); }\n      if (!state.models.length) { const option = document.createElement(\"option\"); option.value = \"\"; option.textContent = \"No installed local model\"; select.append(option); }\n      else select.value = state.models.some(m => m.alias === previous[index]) ? previous[index] : state.models[Math.min(index, state.models.length - 1)].alias;\n    }\n    if (!state.models.length) notice(\"Install a local model in Core → Models, then refresh. Model Compare uses installed models only.\");\n    else if (state.models.length === 1) notice(\"One model is available. You can compare two independent replies from it, or install a second model in Core.\"); controls();\n  }\n  async function saveCurrent() {\n    if (!state.storageReady) { $(\"save-status\").textContent = \"Not saved: existing history needs attention\"; return; }\n    const next = logic.addHistory(state.history, state.current);\n    if (!next.saved) { $(\"save-status\").textContent = \"Response too large to save; select and copy the text to keep it.\"; state.unsaved = false; return; }\n    try { await call(\"storage.set\", { key: \"history\", value: next.entries }); state.history = next.entries; state.unsaved = false; $(\"save-status\").textContent = next.removed ? `Saved · ${next.removed} oldest comparison(s) removed to fit storage` : \"Saved on this device\"; renderHistory(); }\n    catch (error) { state.unsaved = true; $(\"save-status\").textContent = \"Not saved yet\"; controls(); throw error; }\n  }\n  async function run(event) {\n    event.preventDefault(); if (state.busy || state.unsaved) return;\n    let request; try { request = logic.validateRequest($(\"prompt\").value, $(\"model-a\").value, $(\"model-b\").value, Number($(\"tokens\").value), state.models); } catch (error) { notice(error.message, true); return; }\n    state.busy = true; state.running = true; state.stop = false; notice(\"\"); $(\"save-status\").textContent = \"\";\n    const orderedModels = crypto.getRandomValues(new Uint8Array(1))[0] & 1 ? [request.b, request.a] : [request.a, request.b];\n    state.current = { revealed: false, selectedModels: [request.a, request.b], id: `cmp-${Date.now().toString(36)}-${crypto.randomUUID()}`, createdAt: new Date().toISOString(), prompt: request.prompt, maxTokens: request.maxTokens, results: orderedModels.map(model => ({ model, label: state.models.find(m => m.alias === model).label, status: \"queued\", text: \"\", elapsedMs: 0 })) };\n    controls(); renderResults(); $(\"results\").scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n    try {\n      for (let i = 0; i < 2; i++) {\n        const result = state.current.results[i];\n        if (state.stop) { result.status = \"skipped\"; renderResults(); continue; }\n        result.status = \"running\"; $(\"run-status\").textContent = `Running model ${i + 1} of 2…`; renderResults(); const started = performance.now();\n        try { const response = await call(\"inference.local\", { model: result.model, prompt: request.prompt, maxTokens: request.maxTokens }); if (typeof response?.text !== \"string\" || !response.text.trim()) throw Error(\"The model returned an empty response.\"); result.text = response.text; result.status = \"done\"; }\n        catch (error) { result.text = error.message || String(error); result.status = \"error\"; }\n        result.elapsedMs = performance.now() - started; renderResults();\n      }\n      $(\"run-status\").textContent = state.stop ? \"Stopped\" : \"Comparison finished\"; await saveCurrent();\n    } catch (error) { notice(error.message || String(error), true); }\n    finally { state.busy = false; state.running = false; controls(); }\n  }\n  async function guarded(action) { if (state.busy) return; state.busy = true; controls(); try { await action(); } catch (error) { notice(error.message || String(error), true); } finally { state.busy = false; controls(); } }\n  $(\"comparison-form\").addEventListener(\"submit\", run); $(\"refresh\").addEventListener(\"click\", () => guarded(loadModels));\n  $(\"stop\").addEventListener(\"click\", () => { state.stop = true; $(\"run-status\").textContent = \"Will stop when the current model finishes\"; controls(); });\n  $(\"save-again\").addEventListener(\"click\", () => guarded(saveCurrent));\n  const closeDelete = () => { state.pendingDelete = null; $(\"delete-dialog\").close(); };\n  $(\"cancel-delete\").addEventListener(\"click\", closeDelete);\n  $(\"close-delete\").addEventListener(\"click\", closeDelete);\n  $(\"delete-dialog\").addEventListener(\"cancel\", () => { state.pendingDelete = null; });\n  $(\"reveal\").addEventListener(\"click\", () => guarded(async () => {\n    if (!state.current || state.current.results.some(result => [\"queued\", \"running\"].includes(result.status))) return;\n    state.current = { ...state.current, revealed: true }; renderResults(); await saveCurrent();\n  }));\n  for (const button of document.querySelectorAll(\"[data-pick]\")) button.addEventListener(\"click\", () => guarded(async () => {\n    if (!state.current || state.current.revealed === false || !state.current.results.every(result => result.status === \"done\") || ![\"0\", \"1\", \"tie\"].includes(button.dataset.pick)) return;\n    state.current = { ...state.current, pick: button.dataset.pick }; renderResults(); await saveCurrent();\n  }));\n  $(\"confirm-delete\").addEventListener(\"click\", () => guarded(async () => { const next = state.history.filter(item => item.id !== state.pendingDelete); await call(\"storage.set\", { key: \"history\", value: next }); state.history = next; if (state.current?.id === state.pendingDelete) { state.current = null; renderResults(); } state.pendingDelete = null; $(\"delete-dialog\").close(); renderHistory(); }));\n  for (const button of document.querySelectorAll(\"[data-prompt]\")) button.addEventListener(\"click\", () => { $(\"prompt\").value = button.dataset.prompt; $(\"prompt\").focus(); });\n  for (const id of [\"model-a\", \"model-b\", \"tokens\"]) $(id).addEventListener(\"change\", () => guarded(() => call(\"storage.set\", { key: \"preferences\", value: { a: $(\"model-a\").value, b: $(\"model-b\").value, maxTokens: Number($(\"tokens\").value) } })));\n  void guarded(async () => {\n    if (!window.kai?.call || window.kai.apiVersion < 2) throw Error(\"Open this plugin in KAI Core 0.2.0 or later.\");\n    await loadModels();\n    try { state.history = logic.history(await call(\"storage.get\", { key: \"history\" })); renderHistory(); }\n    catch (error) { state.storageReady = false; notice(error.message || String(error), true); }\n    const prefs = await call(\"storage.get\", { key: \"preferences\" });\n    if (prefs) { for (const side of [\"a\", \"b\"]) if (state.models.some(m => m.alias === prefs[side])) $(\"model-\" + side).value = prefs[side]; if ([512, 1024, 2048, 4096].includes(prefs.maxTokens)) $(\"tokens\").value = String(prefs.maxTokens); }\n  });\n})();\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>KAI Model Compare</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<header class=\"workspace-header\"><div class=\"workspace-title\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 4h6v16H4ZM14 4h6v16h-6Z\"/></svg><h1>Model Compare</h1></div><span class=\"workspace-caption\">KAI</span></header>\n<main class=\"cmp-wrap\"><div class=\"page-heading\"><div><h2>Compare models</h2><p class=\"lede\">One prompt, two models, blind. Answers run one at a time because they share this computer. Reveal which was which, then pick your favorite.</p></div><div class=\"model-count\"><span><strong id=\"model-count\">—</strong> local models ready</span><button id=\"refresh\" type=\"button\">Refresh models</button></div></div>\n<div id=\"notice\" class=\"notice\" role=\"status\" hidden></div>\n<form id=\"comparison-form\"><div class=\"model-pickers\"><label for=\"model-a\" class=\"sr-only\">First model</label><select id=\"model-a\" aria-label=\"First model\"><option value=\"\">Loading models…</option></select><span class=\"versus\">vs</span><label for=\"model-b\" class=\"sr-only\">Second model</label><select id=\"model-b\" aria-label=\"Second model\"><option value=\"\">Loading models…</option></select></div>\n<div class=\"examples\" aria-label=\"Example prompts\"><button type=\"button\" data-prompt=\"Explain how a hash table works to someone who has written their first program. Include a small example.\">Explain a concept</button><button type=\"button\" data-prompt=\"Write a concise, friendly email asking a colleague to review a draft by Friday. Include a clear subject line.\">Writing</button><button type=\"button\" data-prompt=\"I have three hours to prepare a presentation about a new product idea. Give me a practical plan and explain what to prioritize.\">Reasoning</button><button type=\"button\" data-prompt=\"Write the opening paragraph of a mystery story set in a lighthouse, at most 80 words, ending on an unresolved detail.\">Creative</button></div>\n<div class=\"prompt-row\"><label class=\"sr-only\" for=\"prompt\">Prompt for both models</label><textarea id=\"prompt\" maxlength=\"16000\" rows=\"2\" placeholder=\"Ask both models the same thing…\" required></textarea><button class=\"primary\" id=\"compare\" type=\"submit\" disabled>Run both</button><button type=\"button\" id=\"stop\" hidden>Stop after current</button></div><div class=\"run-bar\"><label for=\"tokens\">Reply limit <select id=\"tokens\"><option value=\"512\">512 tokens</option><option value=\"1024\" selected>1,024 tokens</option><option value=\"2048\">2,048 tokens</option><option value=\"4096\">4,096 tokens</option></select> per model</label><span id=\"run-status\" role=\"status\"></span></div></form>\n<section id=\"results\" aria-label=\"Comparison results\" hidden><div class=\"results-heading\"><h2 id=\"result-title\" class=\"sr-only\">Answers</h2><button id=\"save-again\" hidden>Retry saving</button><span id=\"save-status\" role=\"status\"></span></div><div class=\"result-grid\"><article id=\"result-a\" class=\"result-card\"><div class=\"result-header\"><div><h3 id=\"name-a\">Answer 1</h3><span id=\"meta-a\">Waiting</span></div><span class=\"state\" id=\"state-a\">QUEUED</span></div><div id=\"text-a\" class=\"result-text\"></div></article><article id=\"result-b\" class=\"result-card\"><div class=\"result-header\"><div><h3 id=\"name-b\">Answer 2</h3><span id=\"meta-b\">Waiting</span></div><span class=\"state\" id=\"state-b\">QUEUED</span></div><div id=\"text-b\" class=\"result-text\"></div></article></div><div id=\"verdict\" class=\"verdict\" hidden><button id=\"reveal\" class=\"primary\" type=\"button\">Reveal models</button><div id=\"vote\" hidden><span>Which answer was better?</span><button type=\"button\" data-pick=\"0\">Answer 1</button><button type=\"button\" data-pick=\"1\">Answer 2</button><button type=\"button\" data-pick=\"tie\">Tie</button></div><span id=\"verdict-note\" role=\"status\"></span></div><p class=\"result-note\">Timing includes local model loading. Both models receive the same prompt.</p></section>\n<section class=\"saved\"><div class=\"saved-heading\"><h2>Saved comparisons</h2><span id=\"history-count\">0 saved</span></div><div id=\"history\" class=\"history\"><p class=\"empty-history\">Your completed comparisons will appear here, saved on this device.</p></div></section>\n</main><dialog id=\"delete-dialog\"><button id=\"close-delete\" class=\"dialog-close\" type=\"button\" aria-label=\"Close delete dialog\" title=\"Close\">×</button><h2>Delete saved comparison?</h2><p>This removes the saved prompt and both responses from this plugin.</p><div class=\"dialog-actions\"><button id=\"cancel-delete\">Keep comparison</button><button id=\"confirm-delete\" class=\"danger\">Delete comparison</button></div></dialog><script src=\"kai-notices.js\"></script><script src=\"logic.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","logic.js":"(function (root, factory) { const api = factory(); if (typeof module === \"object\" && module.exports) module.exports = api; else root.CompareLogic = api; })(typeof globalThis !== \"undefined\" ? globalThis : this, function () {\n  \"use strict\";\n  const MAX_HISTORY_BYTES = 650000, MAX_ENTRIES = 12;\n  function readyModels(value) { return Array.isArray(value) ? value.filter(m => m && m.status === \"ready\" && typeof m.alias === \"string\" && m.alias).map(m => ({ alias: m.alias, label: typeof m.label === \"string\" ? m.label : m.alias })) : []; }\n  function validateRequest(prompt, a, b, tokens, models) { if (typeof prompt !== \"string\" || !prompt.trim() || prompt.length > 16000) throw Error(\"Enter a prompt from 1 to 16,000 characters.\"); if (![512, 1024, 2048, 4096].includes(tokens)) throw Error(\"Choose a valid reply limit.\"); if (![a, b].every(alias => models.some(m => m.alias === alias))) throw Error(\"Choose two available local models.\"); return { prompt: prompt.trim(), a, b, maxTokens: tokens }; }\n  function history(value) { if (value == null) return []; if (!Array.isArray(value) || value.length > MAX_ENTRIES || value.some(item => !item || typeof item.id !== \"string\" || typeof item.prompt !== \"string\" || !Array.isArray(item.results) || item.results.length !== 2 || item.results.some(r => !r || typeof r.model !== \"string\" || ![\"done\", \"error\", \"skipped\"].includes(r.status) || typeof r.text !== \"string\"))) throw Error(\"Saved comparisons could not be read. Their stored data was not replaced.\"); return value; }\n  function addHistory(current, item) {\n    const bytes = value => new TextEncoder().encode(JSON.stringify(value)).length;\n    if (bytes([item]) > MAX_HISTORY_BYTES) return { entries: current, saved: false, removed: 0 };\n    const entries = [item, ...current.filter(old => old.id !== item.id)]; let removed = 0;\n    while (entries.length > MAX_ENTRIES || bytes(entries) > MAX_HISTORY_BYTES) { entries.pop(); removed++; }\n    return { entries, saved: true, removed };\n  }\n  function summarize(result) { if (result.status === \"done\") return `${(Math.max(0, result.elapsedMs) / 1000).toFixed(1)}s · ${result.text.trim().split(/\\s+/u).filter(Boolean).length} words`; return result.status === \"error\" ? \"Request failed\" : result.status === \"skipped\" ? \"Stopped before this model ran\" : result.status === \"running\" ? \"Generating on your device…\" : \"Waiting for the first model\"; }\n  return { readyModels, validateRequest, history, addHistory, summarize, MAX_ENTRIES };\n});\n","style.css":"/* Original Compare models controls and paired answer layout. */\n:root{--bg:#f4f7fd;--panel:#fff;--line:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;--mint:#168469;color-scheme:light}\nbody{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;height:100dvh;display:flex;flex-direction:column;overflow:hidden}.workspace-header{height:74px;min-height:74px;padding:0 34px;display:flex;align-items:center;gap:16px;border-bottom:1px solid var(--line);background:var(--bg)}.workspace-title{display:flex;align-items:center;gap:11px}.workspace-title svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-title h1{font-size:15px;font-weight:650;margin:0}.workspace-caption{margin-left:auto;color:var(--muted);font-size:9px;letter-spacing:1.3px}\n.cmp-wrap{overflow-y:auto;padding:32px 5%;max-width:1150px;width:100%;margin:0 auto;flex:1;min-height:0;display:flex;flex-direction:column;gap:18px}.cmp-wrap>*{flex:none;min-width:0}.page-heading{display:flex;gap:24px;justify-content:space-between;align-items:flex-start}.page-heading h2{font-size:29px;font-weight:600;letter-spacing:-.9px;line-height:1.2;margin:0 0 12px}.lede{font-size:12px;line-height:1.8;color:var(--muted);max-width:720px;margin:0}.model-count{flex:none;display:flex;align-items:flex-end;flex-direction:column;gap:8px;font-size:10px;color:var(--muted)}.model-count strong{font-weight:600}.model-count button{font-size:11px;padding:7px 10px}.model-pickers{display:flex;align-items:center;gap:12px;min-width:0}.model-pickers select{flex:1;width:0;min-width:100px;max-width:100%;background:#f5f8fe;font-size:12px;padding:10px;border-radius:8px;margin:0}.versus{font-size:12px;color:var(--muted)}.examples{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}.examples button{font-size:11px;padding:6px 10px;background:#fff;color:var(--muted);border-radius:20px}.prompt-row{display:flex;align-items:stretch;gap:10px}.prompt-row textarea{flex:1;min-width:0;resize:vertical;min-height:78px;max-height:250px;font-size:13px;background:#fff;padding:12px 14px;border-radius:10px}.prompt-row button{align-self:flex-end;min-height:38px;white-space:nowrap;font-size:12px}.run-bar{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:10px;color:var(--muted);font-size:10px;flex-wrap:wrap}.run-bar label{display:flex;align-items:center;gap:7px;font-size:10px}.run-bar select{margin:0;padding:5px 7px;font-size:10px;width:auto;background:none;border-color:transparent}.run-bar #run-status{color:var(--accent)}\n.results-heading{display:flex;gap:10px;align-items:center;justify-content:flex-end;font-size:10px;color:var(--muted);margin-bottom:8px}.result-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}.result-card{background:#fff;border:1px solid var(--line);border-radius:16px;min-height:180px;overflow:hidden}.result-header{background:#edf4ff;color:#426691;display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:13px 18px;border-bottom:1px solid var(--line)}.result-header h3{font-size:12px;font-weight:650;line-height:1.5;overflow-wrap:anywhere;margin:0 0 3px}.result-header>div{min-width:0}.result-header>div>span{font-size:10px;color:var(--muted)}.state{font-size:8px;font-weight:600;letter-spacing:.4px;white-space:nowrap;padding-top:3px;color:var(--muted)}.running .state{color:var(--accent)}.failed{border-color:#efc5cc}.failed .result-header{background:#fff0f2}.failed .state{color:#a33040}.result-text{padding:20px;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;min-height:120px}.result-note{font-size:10px;color:var(--muted);margin:10px 0 0}.verdict{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}.verdict button{font-size:11px;padding:7px 11px}.verdict #vote{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.verdict span{font-size:11px;color:var(--muted)}\n.saved{border-top:1px solid var(--line);padding-top:21px;margin-top:6px}.saved-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:12px}.saved-heading h2{font-size:15px;font-weight:600;margin:0}.saved-heading>span{font-size:10px;color:var(--muted)}.history{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}.history-row{display:flex;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid var(--line)}.history-row:last-child{border:0}.history-open{display:block;flex:1;min-width:0;background:none;border:0;text-align:left;padding:0}.history-open strong{display:block;font-size:12px;font-weight:550;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.history-open span{display:block;font-size:10px;color:var(--muted);margin-top:4px}.delete-row{font-size:10px;padding:5px 8px;background:none;border:0;color:var(--muted)}.empty-history{font-size:11px;color:var(--muted);padding:18px 20px;margin:0}.notice{padding:10px 12px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;overflow-wrap:anywhere}.notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}\ndialog{width:min(480px,calc(100vw - 32px));border:1px solid var(--line);border-radius:16px;background:#fff;color:var(--text);padding:28px;box-shadow:0 20px 80px #18304f26}dialog::backdrop{background:#122c4b55}dialog h2{font-size:18px;font-weight:600;margin:0 28px 12px 0}dialog p{font-size:12px;color:var(--muted);margin:0 0 20px}.dialog-close{position:absolute;right:12px;top:10px;background:none;border:0;color:var(--muted);font-size:23px;padding:0;width:30px;height:30px;line-height:1}.dialog-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap}.danger{color:var(--danger,#c93d4c)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}\n@media(max-width:800px){.workspace-header{padding:0 23px}.cmp-wrap{padding:25px 23px}.page-heading h2{font-size:26px}.page-heading{gap:16px}.model-count{max-width:110px}.prompt-row{flex-wrap:wrap}.prompt-row textarea{flex-basis:100%}.prompt-row button{margin-left:0}.result-text{padding:16px}}\n@media(max-width:600px){.workspace-header{height:65px;min-height:65px;padding:0 18px}.cmp-wrap{padding:22px 18px}.page-heading{flex-direction:column;gap:12px}.model-count{max-width:none;flex-direction:row;align-items:center;justify-content:space-between;width:100%}.model-pickers{gap:8px}.model-pickers select{font-size:11px;padding:9px 7px;min-width:0}.result-grid{grid-template-columns:1fr}.result-card{min-height:150px}.result-header{padding:12px 15px}.result-text{min-height:100px}.history-row{padding:12px}.history-open span{overflow-wrap:anywhere}.run-bar{gap:6px}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"gbuUykEArrwfueCAH65duK56wT5eXF2LYzG7aR1JR+qc8BeR8jY/eCCEiEaHwyLwF+vNcXxYqxh1cdEmH/9vCg=="}